{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/generation-gate.js",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/assertion-weaken-gate.js",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/constitution-gate.js",
        "matcher": "Write",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/telemetry-ask.js",
        "matcher": "AskQuestion"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/run-eval-report.js",
        "loop_limit": 1
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/run-eval-report.js",
        "loop_limit": 1
      }
    ]
  }
}
