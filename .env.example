# Copy to `.env` and replace placeholders. Never commit `.env`.

# -----------------------------------------------------------------------------
# Run tests (required to clone and run Playwright)
# -----------------------------------------------------------------------------

# Base URL of the Didaxis environment under test (no trailing slash).
DIDAXIS_URL=https://your-env.didaxis.studio

# Admin credentials used by `tests/auth.setup.ts` to write `playwright/.auth/user.json`.
DIDAXIS_EMAIL=your-admin@example.com
DIDAXIS_PASSWORD=your-admin-password

# Bearer JWT for API cleanup (DELETE programs) and direct API checks; refresh when expired.
DIDAXIS_API_TOKEN=your-jwt-access-token

# Optional: second account with reduced permissions for permission-probe scenarios.
# Specs today read DIDAXIS_NON_ADMIN_EMAIL / DIDAXIS_NON_ADMIN_PASSWORD — set those to the same values.
DIDAXIS_ALT_EMAIL=your-non-admin@example.com
DIDAXIS_ALT_PASSWORD=your-non-admin-password

# -----------------------------------------------------------------------------
# Agent / CI setup (not needed for `npx playwright test` alone)
# -----------------------------------------------------------------------------

# Cursor API key for headless `agent` in `.github/workflows/test-generation.yml`.
CURSOR_API_KEY=crsr_your_cursor_api_key

# Atlassian API token for Jira backlog / MCP (create at id.atlassian.com).
ATLASSIAN_API_TOKEN=your_atlassian_api_token

# Atlassian Cloud site URL (e.g. https://your-org.atlassian.net).
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=you@example.com
